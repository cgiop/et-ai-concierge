# Copy this file to .env and add your real keys (never commit .env).

# Backend: gemini (default) | grok
# ET_LLM_PROVIDER=gemini

# Google Gemini - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# xAI Grok - https://console.x.ai/ (OpenAI-compatible API)
# XAI_API_KEY=
# Optional: GROK_API_KEY= (alias)
# GROK_MODEL=grok-2-latest
# GROK_API_BASE=https://api.x.ai/v1

# Optional: some tooling expects this name instead of GEMINI_API_KEY
# GOOGLE_API_KEY=

# Optional model id (default in code: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Optional alert recipients. These are also used for real delivery if provider creds are set.
# ET_MOCK_SMS_TO=
# ET_MOCK_EMAIL_TO=

# Optional explicit alert recipients (override the ET_MOCK_* values above)
# ET_ALERT_SMS_TO=
# ET_ALERT_EMAIL_TO=

# Twilio SMS delivery
# ET_TWILIO_ACCOUNT_SID=
# ET_TWILIO_AUTH_TOKEN=
# ET_TWILIO_FROM=
# ET_TWILIO_API_BASE=https://api.twilio.com

# SMTP email delivery
# ET_SMTP_HOST=
# ET_SMTP_PORT=587
# ET_SMTP_USERNAME=
# ET_SMTP_PASSWORD=
# ET_SMTP_FROM=
# ET_SMTP_USE_STARTTLS=true
# ET_SMTP_USE_SSL=false
